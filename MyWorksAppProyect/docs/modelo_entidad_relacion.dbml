// MyWorksApp — modelo entidad-relación (esquema public, PostgreSQL / Supabase)
// Versión 1.6 · 29 tablas · 2026-09-27
//
// Cómo abrirlo:
//   1) dbdiagram.io  → Import → From DBML  (recomendado)
//   2) dbdocs.io
//   3) DrawSQL       → Import DBML
//   4) pgModeler / DBeaver / DataGrip → usar el .sql hermano
//
// Fuente: dump remoto, rename ES, migraciones Webpay/liquidaciones y modelos Dart.
// Entero 0/1 = boolean de la app. Fechas como text ISO-8601 salvo liquidaciones/tickets.

Project MyWorksApp {
  database_type: 'PostgreSQL'
  Note: '''
    Marketplace de oficios. Hubs: perfiles (cuenta), trabajadores (ficha 1:1),
    trabajos (pedido), pagos (escrow Webpay), liquidaciones (pago al profesional).
    En el servidor, varias FK de “trabajador” apuntan a perfiles.id (uuid),
    no a trabajadores.id_usuario. Aquí se modela el sentido de negocio.
  '''
}

// ---------------------------------------------------------------------------
// Auth (fuera de public; stub para el 1:1)
// ---------------------------------------------------------------------------
Table auth.users [headercolor: #334155] {
  id uuid [pk]
  Note: 'Supabase Auth. perfiles.id = auth.users.id'
}

// ---------------------------------------------------------------------------
// Identidad
// ---------------------------------------------------------------------------
Table perfiles [headercolor: #1e4a7a] {
  id uuid [pk, note: 'mismo id que auth.users']
  nombre text [not null, default: '']
  correo text
  rol text [not null, default: 'usuario', note: 'usuario | trabajador | administrador']
  estado_cuenta text [not null, default: 'activo', note: 'activo | suspendido | bloqueado | eliminado']
  ruta_foto_perfil text
  creado_en text [not null]

  Note: 'Ficha de quien inicia sesión. handle_new_user la crea al registrarse.'
}

Table notificaciones [headercolor: #1e4a7a] {
  id text [pk]
  id_usuario uuid [not null]
  tipo text [not null]
  titulo text [not null]
  cuerpo text [not null]
  id_relacionado text
  leido integer [not null, default: 0, note: '0/1']
  creado_en text [not null]
}

Table suscripciones [headercolor: #1e4a7a] {
  id text [pk]
  id_usuario uuid [not null]
  tipo_plan text [not null]
  estado text [not null]
  fecha_inicio text [not null]
  fecha_fin text
  creado_en text [not null]
  actualizado_en text [not null]
}

Table codigos_restablecimiento [headercolor: #1e4a7a] {
  id text [pk]
  id_usuario uuid [not null]
  codigo text [not null]
  correo text [not null]
  expira_en text [not null]
  usado integer [default: 0, note: '0/1']
  creado_en text [not null]
}

Table consentimientos_usuario [headercolor: #1e4a7a] {
  id text [pk]
  id_usuario uuid [not null]
  version_consentimiento text [not null]
  aceptado integer [not null, default: 0, note: '0/1']
  aceptado_en text [not null]
  direccion_ip text
  agente_usuario text
}

Table bloqueos_usuario [headercolor: #1e4a7a] {
  id text [pk]
  id_bloqueador uuid [not null]
  id_bloqueado uuid [not null]
  creado_en text [not null]
}

Table reportes [headercolor: #1e4a7a] {
  id text [pk]
  id_reportante uuid [not null]
  id_usuario_reportado uuid [not null]
  motivo text [not null]
  descripcion text
  estado text [not null, default: 'pendiente']
  creado_en text [not null]
}

Table eventos_abuso [headercolor: #1e4a7a] {
  id text [pk]
  id_usuario uuid [not null]
  tipo_abuso text [not null]
  conteo integer [not null]
  detectado_en text [not null]
  accion_tomada text
  accion_tomada_en text
  resuelto integer [default: 0, note: '0/1']
}

Table acciones_pendientes [headercolor: #1e4a7a] {
  id text [pk]
  id_usuario uuid [not null]
  tipo_accion text [not null]
  tipo_entidad text [not null]
  id_entidad text
  datos text [not null]
  estado text [not null, default: 'pending_sync']
  conteo_reintentos integer [default: 0]
  mensaje_error text
  creado_en text [not null]
  actualizado_en text [not null]
}

Table registros_error_app [headercolor: #1e4a7a] {
  id text [pk]
  id_usuario uuid
  tipo_error text [not null, default: 'error']
  mensaje text [not null]
  traza_pila text
  metadatos jsonb
  estado text [not null, default: 'new']
  version_app text
  plataforma text
  creado_en text [not null]
}

Table eventos_analitica [headercolor: #1e4a7a] {
  id text [pk]
  nombre_evento text [not null]
  id_usuario uuid
  rol text
  marca_tiempo text [not null]
  metadatos text
}

Table banderas_funcionalidad [headercolor: #1e4a7a] {
  id text [pk]
  nombre_bandera text [not null]
  habilitada integer [not null, default: 0, note: '0/1']
  version_app text
  rol text
  id_usuario uuid
  creado_en text [not null]
  actualizado_en text [not null]
}

// ---------------------------------------------------------------------------
// Catálogo y profesional
// ---------------------------------------------------------------------------
Table trabajadores [headercolor: #2c6a4e] {
  id_usuario uuid [pk, note: 'PK y FK 1:1 a perfiles']
  profesion text [not null, default: '']
  descripcion text
  calificacion double [not null, default: 0]
  disponible integer [not null, default: 1, note: '0/1']
  tarifa_visita double [not null, default: 15000]
  categoria_servicio text [not null, default: 'general']
  niveles_precio jsonb [not null, default: '{}']
  servicios_personalizados jsonb [not null, default: '[]']
  precios_configurados integer [not null, default: 0, note: '0/1']
  zona_trabajo text
  conteo_rechazos integer [not null, default: 0]

  Note: 'Ficha comercial. El catálogo público puede leerla sin sesión.'
}

Table servicios [headercolor: #9a6b18] {
  id text [pk]
  nombre text [not null]
  descripcion text
  categoria text [not null, default: 'general']
  activo integer [not null, default: 1, note: '0/1']
  requiere_certificacion integer [not null, default: 0, note: '0/1']
  modelo_precio text [not null, default: 'hourly']
  aviso_legal text
  creado_en text
  actualizado_en text

  Note: 'Catálogo de oficios del home. Sin filas no hay marketplace.'
}

Table trabajador_servicios [headercolor: #2c6a4e] {
  id_trabajador uuid [not null]
  categoria_servicio text [not null]

  indexes {
    (id_trabajador, categoria_servicio) [pk]
  }

  Note: 'N:M lógico profesional ↔ categoría (slug). No usa servicios.id.'
}

Table portafolio_trabajador [headercolor: #2c6a4e] {
  id text [pk]
  id_trabajador uuid [not null]
  ruta_foto text [not null]
  descripcion text
  tipo_medio text [default: 'photo']
  creado_en text [not null]
}

Table impulsos [headercolor: #2c6a4e] {
  id text [pk]
  id_trabajador uuid [not null]
  tipo_impulso text [not null]
  fecha_inicio text [not null]
  fecha_fin text [not null]
  creado_en text [not null]
}

Table configuraciones_servicio [headercolor: #9a6b18] {
  id text [pk]
  id_servicio text [not null]
  esquema_config text [not null]
  creado_en text [not null]
  actualizado_en text [not null]
}

// ---------------------------------------------------------------------------
// Pedido
// ---------------------------------------------------------------------------
Table trabajos [headercolor: #a24a1c] {
  id text [pk]
  id_usuario uuid [not null, note: 'cliente']
  id_trabajador uuid [note: 'profesional; nullable hasta asignar']
  id_servicio text
  estado text [not null, note: 'pendiente | aceptado | en_curso | completado | …']
  direccion text [not null, default: '']
  latitud double
  longitud double
  descripcion text
  fecha_programada text
  metadatos_servicio text
  modalidad_cobro text [note: 'legado | precio_fijo | bloque_horas | cotizacion_abierta']
  estado_pago text
  id_comuna text
  instantanea_precio text
  id_sku_servicio text
  horas_bloque integer
  id_cotizacion_seleccionada text
  creado_en text [not null]
  actualizado_en text [not null]

  Note: 'Pedido y expediente. El cliente no hace UPDATE de estado: usa transicionar_trabajo.'
}

Table mensajes [headercolor: #a24a1c] {
  id text [pk]
  id_trabajo text [not null]
  id_remitente uuid [not null]
  id_destinatario uuid [not null]
  contenido text [not null]
  tipo text [not null, default: 'text']
  ruta_imagen text
  leido integer [not null, default: 0, note: '0/1']
  creado_en text [not null]
}

Table fotos_trabajo [headercolor: #a24a1c] {
  id text [pk]
  id_trabajo text [not null]
  ruta_foto text [not null]
  tipo_medio text [not null, default: 'photo']
  creado_en text [not null]
}

Table calificaciones [headercolor: #a24a1c] {
  id text [pk]
  id_trabajo text [not null]
  id_usuario uuid
  puntaje integer [not null]
  comentario text
  creado_en text [not null]
}

Table disputas [headercolor: #a24a1c] {
  id text [pk]
  id_trabajo text [not null]
  abierta_por uuid [not null]
  motivo text [not null]
  descripcion text
  estado text [not null, note: 'abierta | en_revision | resuelta']
  resolucion text
  resuelta_por uuid
  resuelta_en text
  creado_en text [not null]
  actualizado_en text [not null]
}

Table cancelaciones_trabajo [headercolor: #a24a1c] {
  id text [pk]
  id_trabajo text [not null]
  cancelado_por uuid [not null]
  motivo text [not null]
  cancelado_en text [not null]
}

Table tickets_soporte [headercolor: #a24a1c] {
  id text [pk]
  id_trabajo text
  nombre_cliente text [not null]
  nombre_trabajador text [not null]
  asunto text [not null]
  monto_escrow integer [not null]
  estado text [default: 'Pending', note: 'Pending | Resolved']
  creado_en timestamptz [default: `now()`]
}

// ---------------------------------------------------------------------------
// Cobro
// ---------------------------------------------------------------------------
Table propuestas_cotizacion [headercolor: #5c4578] {
  id text [pk]
  id_trabajo text [not null]
  id_trabajador uuid [not null]
  monto_total_clp integer [not null]
  descripcion text [not null]
  validez_hasta text
  desglose text
  estado text [not null]
  creado_en text [not null]
}

Table pagos [headercolor: #5c4578] {
  id text [pk]
  id_trabajo text [not null]
  id_orden_cambio text
  tipo_pago text [not null, default: 'principal', note: 'principal | orden_cambio | horas_extra']
  monto double [not null]
  moneda text [not null, default: 'CLP']
  estado text [not null, note: 'pendiente | autorizado | retenido | liberado | reembolsado']
  metodo_pago text
  id_transaccion text
  autorizado_en text
  liberado_en text
  reembolsado_en text
  creado_en text [not null]
  actualizado_en text [not null]
  ambiente text [note: 'integration | production']
  token_tbk text [note: 'solo service_role / Edge']
  url_tbk text [note: 'solo service_role / Edge']
  buy_order text
  handoff_consumido_en timestamptz

  Note: 'Escrow de negocio. Transbank cobra; la app no guarda tarjetas.'
}

Table ordenes_cambio [headercolor: #5c4578] {
  id text [pk]
  id_trabajo text [not null]
  id_trabajador uuid [not null]
  tipo text [not null]
  titulo text [not null]
  descripcion text [not null]
  monto_clp integer [not null]
  estado text [not null, default: 'pending_client']
  id_pago text
  creado_en text [not null]
  respondido_en text
}

Table liquidaciones [headercolor: #5c4578] {
  id text [pk]
  id_pago text [not null, note: 'único: un pago → una liquidación']
  id_trabajo text [not null]
  id_trabajador text [note: 'text; no puede FK a trabajadores.id_usuario (uuid)']
  monto_clp numeric [not null]
  proveedor text [not null, default: 'manual', note: 'manual | khipu | fintoc']
  referencia_transferencia text [not null]
  notas text
  id_operador text [not null]
  creado_en timestamptz [not null, default: `now()`]

  indexes {
    (id_pago) [unique]
  }

  Note: 'Comprobante de transferencia al profesional. Solo admin (RLS).'
}

// ---------------------------------------------------------------------------
// Relaciones (sentido de negocio)
// ---------------------------------------------------------------------------
Ref: perfiles.id - auth.users.id

Ref: trabajadores.id_usuario - perfiles.id [delete: cascade]

Ref: notificaciones.id_usuario > perfiles.id [delete: cascade]
Ref: suscripciones.id_usuario > perfiles.id [delete: cascade]
Ref: codigos_restablecimiento.id_usuario > perfiles.id
Ref: consentimientos_usuario.id_usuario > perfiles.id [delete: cascade]
Ref: bloqueos_usuario.id_bloqueador > perfiles.id
Ref: bloqueos_usuario.id_bloqueado > perfiles.id
Ref: reportes.id_reportante > perfiles.id
Ref: reportes.id_usuario_reportado > perfiles.id
Ref: eventos_abuso.id_usuario > perfiles.id [delete: cascade]
Ref: acciones_pendientes.id_usuario > perfiles.id [delete: cascade]
Ref: registros_error_app.id_usuario > perfiles.id
Ref: eventos_analitica.id_usuario > perfiles.id
Ref: banderas_funcionalidad.id_usuario > perfiles.id

Ref: trabajador_servicios.id_trabajador > trabajadores.id_usuario [delete: cascade]
Ref: portafolio_trabajador.id_trabajador > trabajadores.id_usuario [delete: cascade]
Ref: impulsos.id_trabajador > trabajadores.id_usuario [delete: cascade]
Ref: configuraciones_servicio.id_servicio > servicios.id [delete: cascade]

Ref: trabajos.id_usuario > perfiles.id [delete: cascade]
Ref: trabajos.id_trabajador > trabajadores.id_usuario [delete: set null]
Ref: trabajos.id_servicio > servicios.id [delete: set null]
Ref: trabajos.id_cotizacion_seleccionada > propuestas_cotizacion.id

Ref: mensajes.id_trabajo > trabajos.id [delete: cascade]
Ref: mensajes.id_remitente > perfiles.id
Ref: mensajes.id_destinatario > perfiles.id
Ref: fotos_trabajo.id_trabajo > trabajos.id [delete: cascade]
Ref: calificaciones.id_trabajo > trabajos.id [delete: cascade]
Ref: calificaciones.id_usuario > perfiles.id
Ref: disputas.id_trabajo > trabajos.id [delete: cascade]
Ref: disputas.abierta_por > perfiles.id
Ref: disputas.resuelta_por > perfiles.id
Ref: cancelaciones_trabajo.id_trabajo > trabajos.id [delete: cascade]
Ref: cancelaciones_trabajo.cancelado_por > perfiles.id
Ref: tickets_soporte.id_trabajo > trabajos.id

Ref: propuestas_cotizacion.id_trabajo > trabajos.id [delete: cascade]
Ref: propuestas_cotizacion.id_trabajador > trabajadores.id_usuario [delete: cascade]
Ref: pagos.id_trabajo > trabajos.id [delete: cascade]
Ref: pagos.id_orden_cambio > ordenes_cambio.id
Ref: ordenes_cambio.id_trabajo > trabajos.id [delete: cascade]
Ref: ordenes_cambio.id_trabajador > trabajadores.id_usuario
Ref: ordenes_cambio.id_pago > pagos.id
Ref: liquidaciones.id_pago > pagos.id
Ref: liquidaciones.id_trabajo > trabajos.id

TableGroup identidad {
  perfiles
  notificaciones
  suscripciones
  codigos_restablecimiento
  consentimientos_usuario
  bloqueos_usuario
  reportes
  eventos_abuso
  acciones_pendientes
  registros_error_app
  eventos_analitica
  banderas_funcionalidad
}

TableGroup catalogo {
  trabajadores
  servicios
  trabajador_servicios
  portafolio_trabajador
  impulsos
  configuraciones_servicio
}

TableGroup pedido {
  trabajos
  mensajes
  fotos_trabajo
  calificaciones
  disputas
  cancelaciones_trabajo
  tickets_soporte
}

TableGroup cobro {
  propuestas_cotizacion
  pagos
  ordenes_cambio
  liquidaciones
}
