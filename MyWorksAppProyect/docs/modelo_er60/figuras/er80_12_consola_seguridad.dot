digraph x {
graph [fontname="Helvetica", bgcolor="white", pad="0.08", nodesep="0.3", ranksep="0.45", splines="spline", rankdir="LR", labelloc="t", labeljust="l", label=<<font point-size="12"><b>Figura A-12. Consola y seguridad (tablas A-61 a A-67)</b></font>>];
