digraph x {
graph [fontname="Helvetica", bgcolor="white", pad="0.08", nodesep="0.3", ranksep="0.45", splines="spline", rankdir="LR", labelloc="t", labeljust="l", label=<<font point-size="12"><b>Figura A-14. Evidencia y disputas escalables (tablas A-77 a A-80)</b></font>>];
node [shape=plaintext, fontname="Helvetica"];
edge [fontname="Helvetica", color="#7A4E3A", penwidth="1.2", arrowsize="0.8", dir="both"];
"evidencia_nonces" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#7A4E3A"><tr><td colspan="3" bgcolor="#7A4E3A" align="left"><font color="white" point-size="11"><b>evidencia_nonces</b></font></td></tr><tr><td align="left" bgcolor="#F3EBE6"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#F3EBE6"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#F3EBE6"><font point-size="9" color="#444444">uuid</font></td></tr><tr><td align="left" bgcolor="white"><font point-size="9" color="#555555"> </font></td><td align="left" bgcolor="white"><font point-size="10">nonce</font></td><td align="left" bgcolor="white"><font point-size="9" color="#444444">text</font></td></tr><tr><td align="left" bgcolor="white"><font point-size="9" color="#555555"> </font></td><td align="left" bgcolor="white"><font point-size="10">id_trabajo</font></td><td align="left" bgcolor="white"><font point-size="9" color="#444444">text</font></td></tr></table>>];
"evidencia_procedencia" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#7A4E3A"><tr><td colspan="3" bgcolor="#7A4E3A" align="left"><font color="white" point-size="11"><b>evidencia_procedencia</b></font></td></tr><tr><td align="left" bgcolor="#F3EBE6"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#F3EBE6"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#F3EBE6"><font point-size="9" color="#444444">uuid</font></td></tr><tr><td align="left" bgcolor="white"><font point-size="9" color="#555555"> </font></td><td align="left" bgcolor="white"><font point-size="10">id_foto</font></td><td align="left" bgcolor="white"><font point-size="9" color="#444444">text</font></td></tr><tr><td align="left" bgcolor="white"><font point-size="9" color="#555555"> </font></td><td align="left" bgcolor="white"><font point-size="10">confianza</font></td><td align="left" bgcolor="white"><font point-size="9" color="#444444">text</font></td></tr></table>>];
"alertas_evidencia" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#7A4E3A"><tr><td colspan="3" bgcolor="#7A4E3A" align="left"><font color="white" point-size="11"><b>alertas_evidencia</b></font></td></tr><tr><td align="left" bgcolor="#F3EBE6"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#F3EBE6"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#F3EBE6"><font point-size="9" color="#444444">uuid</font></td></tr><tr><td align="left" bgcolor="white"><font point-size="9" color="#555555"> </font></td><td align="left" bgcolor="white"><font point-size="10">tipo</font></td><td align="left" bgcolor="white"><font point-size="9" color="#444444">text</font></td></tr><tr><td align="left" bgcolor="white"><font point-size="9" color="#555555"> </font></td><td align="left" bgcolor="white"><font point-size="10">hash_perceptual</font></td><td align="left" bgcolor="white"><font point-size="9" color="#444444">text</font></td></tr></table>>];
"reembolsos_automaticos" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#7A4E3A"><tr><td colspan="3" bgcolor="#7A4E3A" align="left"><font color="white" point-size="11"><b>reembolsos_automaticos</b></font></td></tr><tr><td align="left" bgcolor="#F3EBE6"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#F3EBE6"><font point-size="10"><b><u>id_disputa</u></b></font></td><td align="left" bgcolor="#F3EBE6"><font point-size="9" color="#444444">text</font></td></tr><tr><td align="left" bgcolor="white"><font point-size="9" color="#555555"> </font></td><td align="left" bgcolor="white"><font point-size="10">estado</font></td><td align="left" bgcolor="white"><font point-size="9" color="#444444">text</font></td></tr><tr><td align="left" bgcolor="white"><font point-size="9" color="#555555"> </font></td><td align="left" bgcolor="white"><font point-size="10">id_pago</font></td><td align="left" bgcolor="white"><font point-size="9" color="#444444">text</font></td></tr></table>>];
"fotos_trabajo" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#7A4E3A"><tr><td colspan="3" bgcolor="#7A4E3A" align="left"><font color="white" point-size="11"><b>fotos_trabajo</b></font></td></tr><tr><td align="left" bgcolor="#F3EBE6"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#F3EBE6"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#F3EBE6"><font point-size="9" color="#444444">text</font></td></tr></table>>];
"disputas" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="1" color="#7A4E3A"><tr><td colspan="3" bgcolor="#7A4E3A" align="left"><font color="white" point-size="11"><b>disputas</b></font></td></tr><tr><td align="left" bgcolor="#F3EBE6"><font point-size="9" color="#555555">PK</font></td><td align="left" bgcolor="#F3EBE6"><font point-size="10"><b><u>id</u></b></font></td><td align="left" bgcolor="#F3EBE6"><font point-size="9" color="#444444">text</font></td></tr></table>>];
"evidencia_procedencia" -> "fotos_trabajo" [arrowtail="crow", arrowhead="none", label=<<font point-size="9" color="#555555">id_foto</font>>];
"reembolsos_automaticos" -> "disputas" [arrowtail="crow", arrowhead="none", label=<<font point-size="9" color="#555555">id_disputa</font>>];
}