// MyWorksApp — modelo entidad-relación
// Versión 2.0 · 32 tablas public · 2026-10-04
// Importar en https://dbdiagram.io  (Import → From DBML)
//
// Relación ~ : lógica (slug o text vs uuid). No es constraint Postgres.

Project MyWorksApp {
  database_type: 'PostgreSQL'
  Note: 'Esquema public vivo (migraciones ES + liquidaciones + Oneclick + 4NF 20261004)'
}

Table perfiles {
  id uuid [pk]
  nombre text [not null, default: '']
  correo text
  rol text [not null, default: 'usuario']
  estado_cuenta text [not null, default: 'activo']
  ruta_foto_perfil text
  creado_en text [not null]
  Note: 'Identidad de app = auth.users.id'
}

Table trabajadores {
  id_usuario uuid [pk]
  profesion text [not null, default: '']
  descripcion text
  calificacion numeric(4,2) [not null, default: 0]
  disponible integer [not null, default: 1]
  tarifa_visita numeric(12,0) [not null, default: 15000]
  categoria_servicio text [not null, default: 'general']
  niveles_precio jsonb [not null, default: '{}']
  servicios_personalizados jsonb [not null, default: '[]']
  precios_configurados integer [not null, default: 0]
  zona_trabajo text
  conteo_rechazos integer [not null, default: 0]
  Note: 'Ficha 1:1. JSON de oferta se explota a filas hijas.'
}

Table servicios {
  id text [pk]
  nombre text [not null]
  descripcion text
  categoria text [not null, default: 'general']
  activo integer [not null, default: 1]
  requiere_certificacion integer [not null, default: 0]
  modelo_precio text [not null, default: 'por_hora']
  aviso_legal text
  creado_en text
  actualizado_en text
}

Table trabajador_servicios {
  id_trabajador uuid [not null]
  categoria_servicio text [not null]

  indexes {
    (id_trabajador, categoria_servicio) [pk]
  }
  Note: 'N:M por slug categoria, no por servicios.id'
}

Table trabajador_precios {
  id_usuario text [not null]
  codigo text [not null]
  monto_clp numeric(12,0) [not null]
  indexes {
    (id_usuario, codigo) [pk]
  }
  Note: 'Derivada de niveles_precio. id_usuario text, sin FK uuid.'
}

Table trabajador_servicios_extra {
  id text [not null]
  id_usuario text [not null]
  titulo text [not null]
  subtitulo text [not null, default: '']
  monto_clp numeric(12,0) [not null]
  unidad text [not null, default: 'fijo']
  indexes {
    (id_usuario, id) [pk]
  }
  Note: 'Derivada de servicios_personalizados. id_usuario text.'
}

Table portafolio_trabajador {
  id text [pk]
  id_trabajador uuid [not null]
  ruta_foto text [not null]
  descripcion text
  tipo_medio text [default: 'foto']
  creado_en text [not null]
}

Table impulsos {
  id text [pk]
  id_trabajador uuid [not null]
  tipo_impulso text [not null]
  fecha_inicio text [not null]
  fecha_fin text [not null]
  creado_en text [not null]
}

Table configuraciones_servicio {
  id text [pk]
  id_servicio text [not null, unique]
  esquema_config text [not null]
  creado_en text [not null]
  actualizado_en text [not null]
}

Table trabajos {
  id text [pk]
  id_usuario uuid [not null]
  id_trabajador uuid
  id_servicio text
  estado text [not null]
  direccion text [not null, default: '']
  latitud double
  longitud double
  descripcion text
  fecha_programada text
  metadatos_servicio text
  modalidad_cobro text
  estado_pago text
  id_comuna text
  instantanea_precio text
  id_sku_servicio text
  horas_bloque integer
  id_cotizacion_seleccionada text
  creado_en text [not null]
  actualizado_en text [not null]
  Note: 'Pedido. id_trabajador e id_servicio opcionales.'
}

Table propuestas_cotizacion {
  id text [pk]
  id_trabajo text [not null]
  id_trabajador uuid [not null]
  monto_total_clp integer [not null]
  descripcion text [not null]
  validez_hasta text
  desglose text
  estado text [not null]
  creado_en text [not null]
}

Table pagos {
  id text [pk]
  id_trabajo text [not null]
  id_orden_cambio text
  tipo_pago text [not null, default: 'principal']
  monto numeric(12,0) [not null]
  moneda text [not null, default: 'CLP']
  estado text [not null]
  metodo_pago text
  id_transaccion text
  autorizado_en text
  liberado_en text
  reembolsado_en text
  creado_en text [not null]
  actualizado_en text [not null]
  ambiente text
  token_tbk text
  url_tbk text
  buy_order text
  handoff_consumido_en timestamptz
  reembolso_solicitado_en timestamptz
  orden_detalle_oneclick text
  cobro_reclamado_en timestamptz
  Note: 'Escrow. token_tbk/url_tbk no salen al cliente. Un principal vivo por trabajo.'
}

Table ordenes_cambio {
  id text [pk]
  id_trabajo text [not null]
  id_trabajador uuid [not null]
  tipo text [not null]
  titulo text [not null]
  descripcion text [not null]
  monto_clp integer [not null]
  estado text [not null, default: 'pendiente_cliente']
  id_pago text
  creado_en text [not null]
  respondido_en text
}

Table liquidaciones {
  id text [pk]
  id_pago text [not null, unique]
  id_trabajo text [not null]
  id_trabajador text
  monto_clp numeric [not null]
  proveedor text [not null, default: 'manual']
  referencia_transferencia text [not null]
  notas text
  id_operador text [not null]
  creado_en timestamptz [not null]
  Note: 'Un pago → una liquidación. id_trabajador text, sin FK uuid.'
}

Table metodos_pago_oneclick {
  id_usuario text [pk]
  username text [not null]
  tbk_user text
  tipo_tarjeta text
  ultimos4 text
  estado text [not null, default: 'pendiente']
  token_inscripcion text
  id_trabajo_pendiente text
  url_inscripcion text
  ticket_handoff text
  creado_en timestamptz [not null]
  actualizado_en timestamptz [not null]
  Note: 'PK text = auth.uid. tbk_user solo service_role. Sin FK a perfiles.'
}

Table mensajes {
  id text [pk]
  id_trabajo text [not null]
  id_remitente uuid [not null]
  id_destinatario uuid [not null]
  contenido text [not null]
  tipo text [not null, default: 'texto']
  ruta_imagen text
  leido integer [not null, default: 0]
  creado_en text [not null]
}

Table fotos_trabajo {
  id text [pk]
  id_trabajo text [not null]
  ruta_foto text [not null]
  tipo_medio text [not null, default: 'foto']
  creado_en text [not null]
}

Table calificaciones {
  id text [pk]
  id_trabajo text [not null]
  id_usuario uuid
  puntaje integer [not null]
  comentario text
  creado_en text [not null]
}

Table disputas {
  id text [pk]
  id_trabajo text [not null]
  abierta_por uuid [not null]
  motivo text [not null]
  descripcion text
  estado text [not null]
  resolucion text
  resuelta_por uuid
  resuelta_en text
  creado_en text [not null]
  actualizado_en text [not null]
}

Table cancelaciones_trabajo {
  id text [pk]
  id_trabajo text [not null, unique]
  cancelado_por uuid [not null]
  motivo text [not null]
  cancelado_en text [not null]
}

Table tickets_soporte {
  id text [pk]
  id_trabajo text
  nombre_cliente text [not null]
  nombre_trabajador text [not null]
  asunto text [not null]
  monto_escrow integer [not null]
  estado text [default: 'pendiente']
  creado_en timestamptz
}

Table notificaciones {
  id text [pk]
  id_usuario uuid [not null]
  tipo text [not null]
  titulo text [not null]
  cuerpo text [not null]
  id_relacionado text
  leido integer [not null, default: 0]
  creado_en text [not null]
}

Table suscripciones {
  id text [pk]
  id_usuario uuid [not null]
  tipo_plan text [not null]
  estado text [not null]
  fecha_inicio text [not null]
  fecha_fin text
  creado_en text [not null]
  actualizado_en text [not null]
}

Table codigos_restablecimiento {
  id text [pk]
  id_usuario uuid [not null]
  codigo text [not null]
  correo text [not null]
  expira_en text [not null]
  usado integer [default: 0]
  creado_en text [not null]
}

Table consentimientos_usuario {
  id text [pk]
  id_usuario uuid [not null]
  version_consentimiento text [not null]
  aceptado integer [not null, default: 0]
  aceptado_en text [not null]
  direccion_ip text
  agente_usuario text
}

Table bloqueos_usuario {
  id text [pk]
  id_bloqueador uuid [not null]
  id_bloqueado uuid [not null]
  creado_en text [not null]

  indexes {
    (id_bloqueador, id_bloqueado) [unique]
  }
}

Table reportes {
  id text [pk]
  id_reportante uuid [not null]
  id_usuario_reportado uuid [not null]
  motivo text [not null]
  descripcion text
  estado text [not null, default: 'pendiente']
  creado_en text [not null]
}

Table eventos_abuso {
  id text [pk]
  id_usuario uuid [not null]
  tipo_abuso text [not null]
  conteo integer [not null]
  detectado_en text [not null]
  accion_tomada text
  accion_tomada_en text
  resuelto integer [default: 0]
}

Table acciones_pendientes {
  id text [pk]
  id_usuario uuid [not null]
  tipo_accion text [not null]
  tipo_entidad text [not null]
  id_entidad text
  datos text [not null]
  estado text [not null, default: 'pendiente_sync']
  conteo_reintentos integer [default: 0]
  mensaje_error text
  creado_en text [not null]
  actualizado_en text [not null]
}

Table registros_error_app {
  id text [pk]
  id_usuario uuid
  tipo_error text [not null, default: 'error']
  mensaje text [not null]
  traza_pila text
  metadatos jsonb
  estado text [not null, default: 'nuevo']
  version_app text
  plataforma text
  creado_en text [not null]
}

Table eventos_analitica {
  id text [pk]
  nombre_evento text [not null]
  id_usuario uuid
  rol text
  marca_tiempo text [not null]
  metadatos text
}

Table banderas_funcionalidad {
  id text [pk]
  nombre_bandera text [not null]
  habilitada integer [not null, default: 0]
  version_app text
  rol text
  id_usuario uuid
  creado_en text [not null]
  actualizado_en text [not null]
}

Ref: trabajadores.id_usuario - perfiles.id [delete: cascade]
Ref: trabajador_servicios.id_trabajador > trabajadores.id_usuario [delete: cascade]
Ref: portafolio_trabajador.id_trabajador > trabajadores.id_usuario [delete: cascade]
Ref: impulsos.id_trabajador > trabajadores.id_usuario [delete: cascade]
Ref: configuraciones_servicio.id_servicio - servicios.id [delete: cascade]
Ref: trabajos.id_usuario > perfiles.id [delete: cascade]
Ref: trabajos.id_trabajador > trabajadores.id_usuario [delete: set null]
Ref: trabajos.id_servicio > servicios.id [delete: set null]
Ref: trabajos.id_cotizacion_seleccionada > propuestas_cotizacion.id
Ref: propuestas_cotizacion.id_trabajo > trabajos.id [delete: cascade]
Ref: propuestas_cotizacion.id_trabajador > trabajadores.id_usuario [delete: cascade]
Ref: pagos.id_trabajo > trabajos.id [delete: cascade]
Ref: pagos.id_orden_cambio > ordenes_cambio.id
Ref: ordenes_cambio.id_trabajo > trabajos.id [delete: cascade]
Ref: ordenes_cambio.id_trabajador > trabajadores.id_usuario
Ref: ordenes_cambio.id_pago > pagos.id
Ref: liquidaciones.id_pago - pagos.id
Ref: liquidaciones.id_trabajo > trabajos.id
Ref: mensajes.id_trabajo > trabajos.id [delete: cascade]
Ref: mensajes.id_remitente > perfiles.id
Ref: mensajes.id_destinatario > perfiles.id
Ref: fotos_trabajo.id_trabajo > trabajos.id [delete: cascade]
Ref: calificaciones.id_trabajo > trabajos.id [delete: cascade]
Ref: calificaciones.id_usuario > perfiles.id
Ref: disputas.id_trabajo > trabajos.id [delete: cascade]
Ref: disputas.abierta_por > perfiles.id
Ref: disputas.resuelta_por > perfiles.id
Ref: cancelaciones_trabajo.id_trabajo - trabajos.id [delete: cascade]
Ref: cancelaciones_trabajo.cancelado_por > perfiles.id
Ref: tickets_soporte.id_trabajo > trabajos.id
Ref: notificaciones.id_usuario > perfiles.id [delete: cascade]
Ref: suscripciones.id_usuario > perfiles.id [delete: cascade]
Ref: codigos_restablecimiento.id_usuario > perfiles.id
Ref: consentimientos_usuario.id_usuario > perfiles.id [delete: cascade]
Ref: bloqueos_usuario.id_bloqueador > perfiles.id
Ref: bloqueos_usuario.id_bloqueado > perfiles.id
Ref: reportes.id_reportante > perfiles.id
Ref: reportes.id_usuario_reportado > perfiles.id
Ref: eventos_abuso.id_usuario > perfiles.id [delete: cascade]
Ref: acciones_pendientes.id_usuario > perfiles.id [delete: cascade]
Ref: registros_error_app.id_usuario > perfiles.id
Ref: eventos_analitica.id_usuario > perfiles.id
Ref: banderas_funcionalidad.id_usuario > perfiles.id
